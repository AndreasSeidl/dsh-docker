# DeepSeek Harness container — SERVER MODE optional settings.
#
#   cp .env.server.example .env.server      then edit, then:
#   docker compose -f docker-compose.server.yml --env-file .env.server up -d
#   (or run
#   curl -LsSf https://raw.githubusercontent.com/AndreasSeidl/dsh-docker/main/scripts/install.sh | sh -s -- server,
#   which does the copy for you)
#
# Everything here is optional: the server stack runs with no .env.server at
# all, and you can add your API key on the GUI's Settings page instead.

# ── Your model provider ───────────────────────────────────────────────────
# The key the harness talks to DeepSeek with. You can also leave this empty
# and enter the key in the web UI (it is then saved on the dsh-server-home
# volume).
DEEPSEEK_API_KEY=

# Point at a compatible endpoint instead of the default api.deepseek.com.
#DEEPSEEK_BASE_URL=

# ── Where the GUI is published ────────────────────────────────────────────
# The port on this server. (The GUI is served on 3080 inside the container,
# and the startup banner prints this host port.)
#DSH_WEB_PORT=3080

# The address the GUI is published on. SERVER MODE DEFAULTS TO 0.0.0.0 = every
# interface: the whole point is remote access. There is NO login screen, so:
#   * put TLS or a reverse-proxy auth layer (Authelia, basic auth, a VPN) in
#     front before exposing anything beyond a trusted LAN, and
#   * treat the per-boot session token printed in the container log like a
#     password — it is the only thing gating the GUI.
# To force this machine only anyway, set DSH_BIND_ADDRESS=127.0.0.1.
#DSH_BIND_ADDRESS=0.0.0.0

# ── The token URL people actually click ───────────────────────────────────
# The access URL carries a per-run session token (?token=...). By default the
# container prints it as http://localhost:DSH_WEB_PORT, which a remote client
# cannot use. Point DSH_PUBLIC_URL at an origin remote clients actually reach
# so the printed URL is clickable from another machine. ORIGIN ONLY — no path.
# Combine with TLS in front for the scheme: https://harness.example
#DSH_PUBLIC_URL=http://192.168.1.5:3080
#
# If a REAL access layer stands in front of this server (tsdproxy/Tailscale
# ACL, a TLS + auth edge, a VPN), you can drop the token entirely:
# DSH_WEB_AUTH_MODE=trust-proxy makes the bundled proxy exchange the session
# token itself — no 401/token URL dance, the printed URL is just
# https://harness.example. On a plain 0.0.0.0 publish (no such layer) leave the
# default "token" — trust-proxy would open the GUI to anyone who can reach it.
#DSH_WEB_AUTH_MODE=trust-proxy

# ── Image version ─────────────────────────────────────────────────────────
# latest (default), a pinned release like 0.1.1-rc.2, or nightly.
#DSH_TAG=latest

# Run a locally built image instead of the published one (overrides DSH_TAG).
#DSH_IMAGE=dsh:dev

# ── Misc ──────────────────────────────────────────────────────────────────
# Any non-empty value opts out of harness telemetry.
#DSH_TELEMETRY_DISABLED=1

# Silence the container's startup banner.
#DSH_QUIET=1
